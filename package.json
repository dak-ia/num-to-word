{
  "name": "@dak-ia/num-to-word",
  "version": "0.2.1",
  "type": "module",
  "description": "Convert numbers to words in multiple languages (English, Japanese, Chinese, Hindi, Spanish, Arabic, French and more), plus Roman numerals, Japanese daiji and SI prefixes",
  "keywords": [
    "number",
    "word",
    "conversion",
    "i18n",
    "number-to-words",
    "si-prefix",
    "roman-numerals",
    "daiji",
    "kanji",
    "arabic",
    "bengali",
    "chinese",
    "dutch",
    "english",
    "french",
    "german",
    "greek",
    "hindi",
    "indonesian",
    "italian",
    "japanese",
    "korean",
    "polish",
    "portuguese",
    "russian",
    "spanish",
    "thai",
    "turkish",
    "vietnamese"
  ],
  "homepage": "https://github.com/dak-ia/num-to-word#readme",
  "bugs": {
    "url": "https://github.com/dak-ia/num-to-word/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dak-ia/num-to-word.git"
  },
  "license": "MIT",
  "author": "dak-ia",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "docs/places.md",
    "docs/digits.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/generate.ts --check",
    "build": "npm run tsc && vite build && tsc",
    "preview": "vite preview",
    "tsc": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.test.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,html,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,html,css,scss}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/jest": "^0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,md,html,css,scss}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{ts,tsx}": [
      "bash -c 'tsc --noEmit --project tsconfig.json'",
      "bash -c 'tsc --noEmit -p tsconfig.test.json'"
    ],
    "scripts/**/*.ts": [
      "bash -c 'tsc --noEmit -p tsconfig.scripts.json'"
    ]
  },
  "dependencies": {
    "expand-exponential": "^0.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  }
}
